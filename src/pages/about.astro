---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import BlockHeader from "../components/BlockHeader.astro";
import { SITE } from "../config/site";
import { ABOUT } from "../config/about";
---

<BaseLayout
    title="About"
    description={`关于 ${SITE.author}、这个博客和朋友们。`}
>
    <div data-pagefind-body>
        <PageIntro title="About" />
        <div class="about shell">
            <section aria-labelledby="about-me">
                <BlockHeader id="about-me">About Me</BlockHeader>
                <div class="identity">
                    {SITE.profile.avatar && (
                        <img
                            src={SITE.profile.avatar}
                            alt={SITE.profile.avatarAlt}
                            width="144"
                            height="144"
                        />
                    )}
                    <ul class="interests" aria-label="兴趣方向">
                        {ABOUT.interests.map((interest) => (
                            <li>
                                {interest.retired ? (
                                    <del>{interest.label}</del>
                                ) : (
                                    interest.label
                                )}
                            </li>
                        ))}
                    </ul>
                </div>
                {ABOUT.bio.map((paragraph) => (
                    <p>{paragraph}</p>
                ))}
            </section>

            <section aria-labelledby="friends">
                <BlockHeader id="friends">Friends</BlockHeader>
                <p class="muted">真正的高手们</p>
                {ABOUT.friends.length ? (
                    <ul class="friends">
                        {ABOUT.friends.map((friend) => (
                            <li>
                                {friend.avatar && (
                                    <img
                                        src={friend.avatar}
                                        alt=""
                                        width="40"
                                        height="40"
                                        loading="lazy"
                                        referrerpolicy="no-referrer"
                                    />
                                )}
                                <div>
                                    <a
                                        href={friend.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {friend.name}
                                    </a>
                                    {friend.description && (
                                        <p>{friend.description}</p>
                                    )}
                                </div>
                            </li>
                        ))}
                    </ul>
                ) : (
                    <p class="muted">友人链接正在整理中。</p>
                )}
            </section>
        </div>
    </div>
</BaseLayout>

<style>
    .about {
        width: min(calc(100% - 3rem), var(--measure));
        padding-bottom: 3rem;
        overflow-wrap: anywhere;
    }
    .about :global(.block-header) { margin-top: 0; }
    section + section {
        margin-top: 2.75rem;
    }
    p {
        margin: 0.85rem 0;
        line-height: var(--leading-body);
    }
    a {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }
    a:hover {
        color: var(--text);
    }
    .identity {
        text-align: center;
    }
    .identity img {
        display: block;
        box-sizing: content-box;
        width: 9rem;
        height: 9rem;
        margin: 1.75rem auto;
        object-fit: cover;
        border: 8px solid color-mix(in srgb, var(--accent) 15%, transparent);
        border-radius: 50%;
    }
    .muted {
        color: var(--muted);
    }
    .interests {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 1.75rem 0;
        font-weight: 700;
        line-height: 1.75;
    }
    .interests li {
        display: flex;
        gap: 0.5rem;
    }
    .interests li + li::before {
        content: "|";
    }
    .friends {
        list-style: none;
        padding: 0;
        margin: 1.25rem 0 0;
    }
    .friends li {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
    }
    .friends img {
        width: 2.5rem;
        height: 2.5rem;
        object-fit: cover;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .friends li + li {
        margin-top: 1.25rem;
    }
    .friends p {
        margin: 0.25rem 0 0;
        color: var(--muted);
    }
    @media (max-width: 48rem) {
        .about {
            width: min(calc(100% - 1.5rem), var(--measure));
        }
    }
</style>
