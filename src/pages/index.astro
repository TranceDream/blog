---
import ChevronsRight from '../icons/chevrons-right.svg';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockHeader from '../components/BlockHeader.astro';
import PageIntro from '../components/PageIntro.astro';
import PostItem from '../components/PostItem.astro';
import { getVisiblePosts } from '../lib/posts';
import Profile from '../components/Profile.astro';

const posts = await getVisiblePosts();
const latest = posts.slice(0, 3);
---

<BaseLayout>
  <PageIntro as="p" title="Home" />
  <div class="home shell">
    <Profile />

    <section aria-label="Latest Posts">
      <BlockHeader>Latest Posts</BlockHeader>
      {latest.map((post) => <PostItem post={post} />)}
      <div class="archive-action">
        <a class="archive-link action-button action-button--responsive" href="/archive/">Archive
          <ChevronsRight aria-hidden="true" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    width: min(calc(100% - 3rem), var(--measure));
    padding-bottom: 4rem;
  }
  .home :global(.block-header) { margin-top: 1.75rem; }
  .archive-action { display: flex; justify-content: center; margin-block: 1.25rem; }
  @media (max-width: 48rem) { .home { width: min(calc(100% - 1.5rem), var(--measure)); } }
  @media (max-width: 40rem) { .home :global(.block-header) { margin-top: 1rem; } }
</style>
