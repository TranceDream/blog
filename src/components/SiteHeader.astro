---
import ThemeSwitcher from './ThemeSwitcher.astro';
import Search from './Search.astro';
import { SITE } from '../config/site';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/archive/', label: 'Archive' },
  ...(SITE.features.labs ? [{ href: '/labs/', label: 'Labs' }] : []),
  { href: '/about/', label: 'About' },
];
---

<header class="site-header shell" data-pagefind-ignore>
  <div class="title-bar">
    <a class="brand" href="/" aria-label={`${SITE.title} 首页`}>{SITE.title}</a>
    <div class="header-actions">
      <Search />
      <ThemeSwitcher />
    </div>
  </div>
  <nav aria-label="主导航">
    {links.map((link) => (
      <a class:list={{ active: pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href)) }} href={link.href}>
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    width: min(calc(100% - 3rem), var(--measure));
    padding-top: 2.5rem;
  }
  .title-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.25rem;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .brand {
    display: block;
    max-width: 100%;
    padding: 0.38rem 1rem;
    border-radius: 0.75rem;
    background: var(--accent);
    color: var(--bg);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.5rem;
    letter-spacing: -0.02em;
  }
  .header-actions { display: flex; align-items: center; gap: 0.75rem; margin-right: 0.75rem; color: var(--accent); }
  .header-actions :global(.header-action) {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--accent);
    cursor: pointer;
  }
  .header-actions :global(.header-action:hover) { color: var(--text); }
  .header-actions :global(.header-action svg) { width: 100%; height: 100%; }
  nav { display: flex; gap: 1.25rem; align-items: center; margin: 1rem 0 0 0.125rem; }
  nav a {
    color: var(--accent);
    font-size: var(--text-base);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  nav a:hover { color: var(--text); }
  nav a.active { color: var(--text); font-weight: 700; }
  @media (max-width: 36rem) {
    .site-header { padding-top: 1rem; }
    nav { gap: 0.9rem 1.15rem; flex-wrap: wrap; }
  }
  @media (max-width: 48rem) {
    .site-header { width: min(calc(100% - 1.5rem), var(--measure)); }
    .header-actions { margin-right: 0; }
  }
</style>
