---
import Tags from './Tags.astro';
import DraftBadge from './DraftBadge.astro';
import { Image } from 'astro:assets';
import type { PostEntry } from '../lib/posts';
import { formatDate, postTitle, seriesHref } from '../lib/posts';

interface Props {
  post: PostEntry;
  minutesRead?: string;
  interactive?: boolean;
}

const { post, minutesRead, interactive = false } = Astro.props;
const title = postTitle(post);
const readingTime = minutesRead;
---

<header class:list={['article-head shell', { interactive }]}>
  <h1 class="detail-title" data-pagefind-meta="title"># {title}</h1>

  <div class="post-info">
    <div class="info-row">
      {post.data.series && <a class="series tag-chip" href={seriesHref(post.data.series)}>{post.data.series}</a>}
      <div class="meta">
        <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt).replaceAll('/', '-')}</time>
        {post.data.author && <span>{post.data.author}</span>}
        {readingTime && <span>{readingTime}</span>}
        {post.data.updatedAt && <span>updated <time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt).replaceAll('/', '-')}</time></span>}
        <DraftBadge draft={post.data.draft} />
      </div>
    </div>
    <Tags tags={post.data.tags} />
  </div>
  {post.data.description && <p class="description">{post.data.description}</p>}
  {post.data.coverImage && (
    <Image
      src={post.data.coverImage.src}
      alt={post.data.coverImage.alt}
      class="cover"
      layout="constrained"
      priority
    />
  )}
</header>

<style>
  .article-head {
    width: min(calc(100% - 3rem), var(--measure));
    padding-block: 2.5rem 0;
  }
  .post-info { margin-block: 0.5rem; border-left: 2px solid color-mix(in srgb, var(--accent) 80%, transparent); padding: 0.5rem 0 0.5rem 1rem; color: color-mix(in srgb, var(--text) 80%, transparent); }
  .info-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem; }
  .meta { padding-left: 2px; font-size: var(--text-base); line-height: var(--leading-ui); overflow-wrap: anywhere; }
  .meta > :not(:first-child)::before { content: '·'; display: inline-block; margin-inline: 0.5rem; }
  .series { margin-right: 0.5rem; }
  .post-info :global(.tags) { margin: 1rem 0 0; }
  .description { margin: 1.25rem 0 0; color: var(--text); line-height: var(--leading-body); }
  @media (max-width: 39.999rem) { .info-row { flex-direction: column; align-items: flex-start; gap: 1rem; } }
  .cover { display: block; width: 100%; margin: 1.75rem 0 0; border: 8px solid color-mix(in srgb, var(--text) 10%, transparent); border-radius: 0.75rem; }

  @media (max-width: 48rem) {
    .article-head { width: min(calc(100% - 1.5rem), var(--measure)); }
  }
</style>
