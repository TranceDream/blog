---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant?: 'aside' | 'inline';
}

const { headings, variant = 'aside' } = Astro.props;
const items = headings.filter(({ depth }) => depth >= 2 && depth <= 3);
---

<details class:list={['toc', `toc-${variant}`]} open data-toc data-pagefind-ignore>
  <summary>Table of Contents</summary>
  <nav aria-label="文章目录">
    <ol>
      {items.map((heading) => (
        <li data-depth={heading.depth}>
          <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
</details>

<script>
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((toc) => {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const sections = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((section): section is HTMLElement => Boolean(section));
    if (!sections.length || sections.length !== links.length) return;

    let queued = false;
    const update = () => {
      queued = false;
      const position = window.scrollY + 110;
      let active = 0;
      sections.forEach((section, index) => {
        if (section.offsetTop <= position) active = index;
      });
      links.forEach((link, index) => {
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      window.requestAnimationFrame(update);
    }, { passive: true });
    update();
  });
</script>

<style>
  .toc {
    min-width: 0;
    margin: 0 0 2rem;
    padding: 1rem 1.1rem;
    border: 3px solid color-mix(in srgb, var(--accent) 12%, transparent);
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--text) 4%, transparent);
    color: var(--muted);
    font-size: 0.72rem;
  }
  summary { position: relative; padding-left: 1rem; color: var(--text); font-weight: 650; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::before { position: absolute; left: 0; content: '>'; color: var(--accent); }
  details[open] summary::before { transform: rotate(90deg); }
  nav { margin-top: 0.8rem; }
  ol { display: grid; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
  li[data-depth="3"] { padding-left: 0.85rem; }
  a { display: block; padding: 0.2rem 0.4rem; border-left: 2px solid transparent; color: var(--muted); line-height: 1.45; }
  a:hover,
  a[aria-current] { border-left-color: var(--accent); color: var(--accent); }
  @media (min-width: 68rem) {
    .toc-aside { position: sticky; top: 2rem; margin: 0; background: transparent; }
  }
</style>
