---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant?: 'aside' | 'inline';
}

const { headings, variant = 'aside' } = Astro.props;
const items = headings.filter(({ depth }) => depth >= 2 && depth <= 3);
---

<details class:list={['toc', `toc-${variant}`]} open data-toc data-pagefind-ignore>
  <summary>Table of Contents</summary>
  <nav aria-label="文章目录">
    <ol>
      {items.map((heading) => (
        <li data-depth={heading.depth}>
          <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
</details>

<script>
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((toc) => {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const sections = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((section): section is HTMLElement => Boolean(section));
    if (!sections.length || sections.length !== links.length) return;

    let queued = false;
    const update = () => {
      queued = false;
      const position = window.scrollY + 110;
      let active = 0;
      sections.forEach((section, index) => {
        if (section.getBoundingClientRect().top + window.scrollY <= position) active = index;
      });
      links.forEach((link, index) => {
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      window.requestAnimationFrame(update);
    }, { passive: true });
    update();
  });
</script>

<style>
  .toc { position: relative; min-width: 0; margin: 1.25rem 0 2rem; padding: 1.5rem 2rem; border: 3px solid color-mix(in srgb, var(--accent) 10%, transparent); border-radius: 0.75rem; background: color-mix(in srgb, var(--text) 5%, transparent); color: color-mix(in srgb, var(--text) 90%, transparent); font-size: var(--text-sm); }
  summary { cursor: pointer; list-style: none; line-height: 1.5; }
  summary::-webkit-details-marker { display: none; }
  summary::before { position: absolute; left: 0.75rem; content: '>'; color: var(--accent); font-weight: 600; }
  details[open] summary::before { transform: rotate(90deg); }
  nav { margin-top: 1rem; }
  ol { margin: 0; padding: 0; list-style: none; }
  li { position: relative; padding-left: 1.75rem; border-left: 2px solid color-mix(in srgb, var(--text) 20%, transparent); }
  li::before { content: ''; position: absolute; left: 0; top: 1rem; width: 1rem; border-top: 1px solid color-mix(in srgb, var(--text) 20%, transparent); }
  li:last-child { border-left-color: transparent; }
  li:last-child::after { content: ''; position: absolute; left: -2px; top: 0; height: 1rem; border-left: 2px solid color-mix(in srgb, var(--text) 20%, transparent); }
  li[data-depth="3"] { padding-left: 2.75rem; }
  li[data-depth="3"]::before { width: 2rem; }
  a { display: block; padding: 0.25rem 0; line-height: 1.5; overflow-wrap: anywhere; }
  a:hover, a[aria-current] { color: var(--accent); }
  a[aria-current] { font-weight: 600; }
  @media (min-width: 80rem) { .toc-aside { margin: 0; border: 0; background: transparent; padding: 0 0 0 2rem; max-height: calc(100svh - 5rem); overflow-y: auto; } }
</style>
