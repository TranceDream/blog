---
import type { PostEntry } from '../lib/posts';
import { postHref, postTitle } from '../lib/posts';

interface Props {
  newer?: PostEntry;
  older?: PostEntry;
}

const { newer, older } = Astro.props;
---

{(newer || older) && (
  <nav class="post-navigation shell" aria-label="相邻文章" data-pagefind-ignore>
    {newer
      ? <a href={postHref(newer)}><small>← Newer</small><span>{postTitle(newer)}</span></a>
      : <span aria-hidden="true"></span>}
    {older && <a class="older" href={postHref(older)}><small>Older →</small><span>{postTitle(older)}</span></a>}
  </nav>
)}

<style>
  .post-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    width: min(calc(100% - 3rem), var(--measure));
    padding-block: 1rem 5.5rem;
  }
  .post-navigation a { display: grid; gap: 0.35rem; padding: 0.85rem 1rem; border: 3px double color-mix(in srgb, var(--accent) 30%, transparent); border-radius: 0.65rem; color: var(--text); }
  .post-navigation a:hover { background: color-mix(in srgb, var(--accent) 7%, transparent); }
  .post-navigation small { color: var(--accent); font-size: 0.58rem; letter-spacing: 0.1em; }
  .post-navigation span { font-size: 0.72rem; line-height: 1.5; }
  .post-navigation .older { text-align: right; }

  @media (max-width: 48rem) {
    .post-navigation {
      grid-template-columns: 1fr;
      width: min(calc(100% - 1.5rem), var(--measure));
    }
    .post-navigation > span { display: none; }
    .post-navigation .older { text-align: left; }
  }
</style>
