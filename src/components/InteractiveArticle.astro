---
interface Props {
  label?: string;
  /** 由 remark-interactive-panels 在正文含展示面板时注入。 */
  hasDisplay?: boolean;
}

const { label = '文章交互展示', hasDisplay = false } = Astro.props;
---

<div class:list={['interactive-article', { 'without-display': !hasDisplay }]} data-interactive-article>
  {hasDisplay && <script is:inline>document.currentScript.parentElement.dataset.stageMounted = 'true';</script>}
  <div class="interactive-copy" data-interactive-copy>
    {hasDisplay && (
      <noscript>
        <p class="interactive-noscript">当前浏览器未启用 JavaScript：展示内容已按顺序插入正文，其中的交互控件不可用。</p>
      </noscript>
    )}
    <div class="prose"><slot /></div>
  </div>

  {hasDisplay && (
    <aside class="interactive-display" aria-label={label} data-pagefind-ignore>
      <div class="stage-viewport"></div>
    </aside>
  )}
</div>

{hasDisplay && (
  <script is:inline>
    (() => {
      const root = document.currentScript.previousElementSibling;
      root?.querySelector('.stage-viewport')?.append(...root.querySelectorAll('[data-interactive-copy] > .prose > [data-stage-panel]'));
    })();
  </script>
)}

<script>
  import { bindArticleStages } from '../lib/articleStages';

  document.querySelectorAll<HTMLElement>('[data-interactive-article]').forEach((root) => {
    const display = root.querySelector<HTMLElement>('.interactive-display');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (display) {
      const applyPresence = (bounds: DOMRectReadOnly) => {
        const viewportHeight = window.innerHeight;
        const enterStart = viewportHeight * 0.72;
        const enterEnd = viewportHeight * 0.22;
        const exitStart = Math.min(bounds.height, viewportHeight * 0.9);
        const exitEnd = exitStart - Math.min(bounds.height * 0.55, viewportHeight * 0.35);
        const clamp = (value: number) => Math.max(0, Math.min(1, value));
        // Entry and exit must agree at top=0, including the shorter mobile stage.
        const presence = reduceMotion.matches ? 1 : Math.min(
          clamp((enterStart - bounds.top) / (enterStart - enterEnd)),
          clamp((bounds.bottom - exitEnd) / (exitStart - exitEnd)),
        );

        display.style.setProperty('--stage-presence', presence.toFixed(3));
        display.style.setProperty('--stage-content', clamp((presence - 0.3) / 0.7).toFixed(3));
      };

      applyPresence(display.getBoundingClientRect());
      let frame = 0;
      const schedule = () => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          applyPresence(display.getBoundingClientRect());
        });
      };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      reduceMotion.addEventListener('change', schedule);
      new ResizeObserver(schedule).observe(display);
    }

    bindArticleStages(root);
  });
</script>

<style>
  .interactive-article {
    --stage-bg: #17191f;
    --stage-text: #eceef3;
    --stage-muted: #9aa1ad;
    --stage-accent: color-mix(in srgb, var(--accent) 68%, white);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    align-items: start;
    width: 100%;
  }
  /* 面板未移入舞台（无脚本）时按普通文章单栏排版。 */
  .interactive-article:is(.without-display, :not([data-stage-mounted])) {
    grid-template-columns: minmax(0, var(--measure));
    justify-content: center;
    width: min(calc(100% - 3rem), var(--measure));
    margin-inline: auto;
  }
  .interactive-article:not([data-stage-mounted]) .interactive-display { display: none; }
  /* 开头的脚本先切换为舞台布局，末尾的脚本再移入面板；两者之间不显示正文内的面板。 */
  .interactive-article[data-stage-mounted] .interactive-copy :global(.prose > [data-stage-panel]) { display: none; }
  .interactive-copy {
    width: 100%;
    min-width: 0;
    padding-inline: max(1.5rem, calc((100vw - var(--page)) / 2)) clamp(1.5rem, 3vw, 3rem);
  }
  .interactive-article:is(.without-display, :not([data-stage-mounted])) .interactive-copy { width: 100%; padding-inline: 0; }
  .interactive-noscript {
    margin: 0 0 2rem;
    padding: 0.75rem 1rem;
    border-left: 2px solid var(--accent);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
  }
  /* 正文内面板沿用 .prose 的控件样式，因此把其依赖的主题变量换成舞台配色。 */
  .interactive-copy :global(.prose > [data-stage-panel]) {
    --bg: var(--stage-bg);
    --text: var(--stage-text);
    --muted: var(--stage-muted);
    --accent: var(--stage-accent);
    --surface: color-mix(in srgb, var(--stage-text) 6%, var(--stage-bg));
    --line: color-mix(in srgb, var(--stage-text) 14%, transparent);
    --line-strong: color-mix(in srgb, var(--stage-text) 26%, transparent);
    margin-block: 1.5rem 2rem;
    padding: 1.5rem;
    border-radius: var(--radius-panel);
    background: var(--stage-bg);
    color: var(--stage-text);
    color-scheme: dark;
    line-height: 1.75;
  }
  .interactive-copy :global(.prose > [data-stage-panel][data-label])::before {
    content: attr(data-label);
    display: block;
    margin-bottom: 1rem;
    color: var(--stage-muted);
    font-size: var(--text-sm);
  }
  .interactive-display {
    --stage-presence: 1;
    --stage-content: 1;
    position: sticky;
    top: 0;
    isolation: isolate;
    min-width: 0;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    background: transparent;
    color: var(--stage-text);
    color-scheme: dark;
  }
  .interactive-display::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 0;
    background: var(--stage-bg);
    opacity: var(--stage-presence);
    pointer-events: none;
    transition: opacity 90ms linear;
  }
  .stage-viewport {
    position: relative;
    z-index: 1;
    display: grid;
    height: 100%;
    overflow: hidden;
    opacity: var(--stage-content);
    transition: opacity 90ms linear;
  }
  .stage-viewport > :global([data-stage-panel]) {
    grid-area: 1 / 1;
    align-content: safe center;
    justify-self: center;
    width: min(100%, 30rem);
    min-width: 0;
    min-height: 100%;
    padding: clamp(2rem, 5vw, 4rem);
    overflow: auto;
    color: var(--stage-text);
    line-height: 1.75;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 160ms ease-out, visibility 0s linear 160ms;
  }
  .stage-viewport > :global([data-stage-panel][data-stage-active="true"]),
  .interactive-article:not([data-stage-ready="true"]) .stage-viewport > :global([data-stage-panel]:first-child) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }
  .interactive-article:not([data-stage-ready="true"]) .stage-viewport > :global([data-stage-panel]:not(:first-child)) { display: none; }
  .interactive-article :global([data-stage-panel] > :first-child) { margin-top: 0; }
  .interactive-article :global([data-stage-panel] > :last-child) { margin-bottom: 0; }
  .interactive-article :global([data-stage-panel] :where(p, ul, ol, figure, form, details)) { margin-block: 1.25rem; }
  .interactive-article :global([data-stage-panel] :where(ul, ol)) { padding-left: 1.5rem; }
  .interactive-article :global([data-stage-panel] :where(strong, :not(pre) > code)) { color: var(--stage-accent); }
  .interactive-article :global([data-stage-panel] small) { color: var(--stage-muted); }
  .interactive-article :global([data-stage-panel] fieldset) { display: grid; gap: 1rem; margin: 0; padding: 0; border: 0; }
  .interactive-article :global([data-stage-panel] label) { display: flex; gap: 0.75rem; align-items: center; }
  .interactive-article :global([data-stage-panel] .expressive-code) { margin: 0; }
  /* 高亮颜色跟随全站主题，代码块需保留主题自身背景，浅色主题下才不会与深色舞台冲突。 */
  .interactive-article :global([data-stage-panel] .expressive-code figure) {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--stage-text) 14%, transparent) !important;
    border-radius: var(--radius-control) !important;
    background: var(--ec-codeBg) !important;
    box-shadow: none !important;
  }
  .interactive-article :global([data-stage-panel] .expressive-code figure > pre) {
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
  }
  .interactive-article :global([data-stage-panel] .expressive-code figure.frame > figcaption.header) { display: none; }

  @media (max-width: 60rem) {
    .interactive-article {
      display: flex;
      flex-direction: column;
      width: min(calc(100% - 3rem), var(--measure));
      margin-inline: auto;
    }
    .interactive-copy { width: 100%; padding-inline: 0; }
    .interactive-article[data-stage-mounted]:not(.without-display) .interactive-copy :global(:is(h2, h3, h4, h5, h6)) {
      scroll-margin-top: calc(52svh + 1.5rem);
    }
    .interactive-display {
      position: sticky;
      z-index: 2;
      top: 0;
      order: -1;
      display: grid;
      grid-template-rows: minmax(0, 1fr);
      width: 100vw;
      height: 52svh;
      margin-inline: calc(50% - 50vw);
    }

  }
  @media (max-width: 48rem) {
    .interactive-article { width: min(calc(100% - 1.5rem), var(--measure)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .interactive-display::before,
    .stage-viewport { opacity: 1; transition: none; }
    .stage-viewport > :global([data-stage-panel]) { transition: none; }
  }
</style>
