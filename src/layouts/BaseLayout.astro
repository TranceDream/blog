---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MediaViewer from '../components/MediaViewer.astro';
import { SITE } from '../config/site';
import { DEFAULT_THEME, THEMES, THEME_STORAGE_KEY } from '../config/themes';
import { getThemePalettes } from '../lib/themes';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = '/social-cards/__default.png',
  noindex = false,
} = Astro.props;
const pageTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
const isDetailPage = (/^\/archive\/.+\/?$/.test(Astro.url.pathname) && !/^\/archive\/page\/\d+\/?$/.test(Astro.url.pathname))
  || (SITE.features.labs && /^\/labs\/.+\/?$/.test(Astro.url.pathname));
const canonicalUrl = !noindex && Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const socialImage = new URL(image, SITE.url);
const themePalettes = await getThemePalettes();
const themeCss = THEMES.map((theme) => {
  const palette = themePalettes[theme];
  return `:root[data-theme="${theme}"]{color-scheme:${palette.colorScheme};--bg:${palette.background};--text:${palette.foreground};--accent:${palette.accent};--accent-2:${palette.link};--heading-1:${palette.heading1};--heading-2:${palette.heading2};--heading-3:${palette.heading3};--heading-4:${palette.heading4};--heading-5:${palette.heading5};--heading-6:${palette.heading6};--list:${palette.list};--separator:${palette.separator};--note:${palette.note};--tip:${palette.tip};--important:${palette.important};--caution:${palette.caution};--warning:${palette.warning}}`;
}).join('');
const themeBackgrounds = Object.fromEntries(
  THEMES.map((theme) => [theme, themePalettes[theme].background]),
);
---

<!doctype html>
<html lang={SITE.locale} data-theme={DEFAULT_THEME}>
  <head>
    <style is:inline set:html={themeCss}></style>
    <meta name="theme-color" content={themePalettes[DEFAULT_THEME].background} />
    <script
      is:inline
      define:vars={{ themes: THEMES, defaultTheme: DEFAULT_THEME, storageKey: THEME_STORAGE_KEY, themeBackgrounds }}
    >
      (() => {
        const legacyThemes = {
          mocha: 'catppuccin-mocha',
          latte: 'catppuccin-latte',
          kanagawa: 'kanagawa-wave',
        };
        try {
          const saved = localStorage.getItem(storageKey);
          const migrated = legacyThemes[saved] ?? saved;
          const selected = themes.includes(migrated) ? migrated : defaultTheme;
          document.documentElement.dataset.theme = selected;
          localStorage.setItem(storageKey, selected);
          const themeMeta = document.querySelector('meta[name="theme-color"]');
          if (themeMeta) themeMeta.setAttribute('content', themeBackgrounds[selected]);
        } catch {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('/rss.xml', SITE.url).href} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl.toString()} />}
    <meta property="og:type" content={isDetailPage ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale.replace('-', '_')} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl.toString()} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage.toString()} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage.toString()} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <MediaViewer />
  </body>
</html>
